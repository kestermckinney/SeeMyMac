{
    "folders": [
        {
            "path": ".",
            "file_exclude_patterns": [
                "*.sublime-workspace",
                ".gitignore"
            ],
            "folder_exclude_patterns": [
                "target",
                ".venv",
                ".*",
                "graphify-out"
            ],
            "binary_file_patterns": [
                "*.png",
                "*.jpg",
                "*.ico",
                "*.zip",
                "*.so",
                "*.a",
                "*.o",
                "*.rlib"
            ],
            "index_exclude_patterns": [
                "target/*",
                ".venv/*"
            ]
        }
    ],
    "build_systems": [
        {
            "name": "SeeMyMac - Debug x86 / x64",
            "selector": "source.rust",
            "working_dir": "$project_path",
            "file_regex": "^\\s*--> (..[^:]*):([0-9]+):?([0-9]+)?",
            "windows": {
                "shell_cmd": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-windows.ps1 -Architecture x86"
            },
            "osx": {
                "shell_cmd": "cargo build --locked --target x86_64-apple-darwin",
                "env": {
                    "PATH": "$HOME/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
                }
            },
            "linux": {
                "shell_cmd": "cargo build --locked --target x86_64-unknown-linux-gnu",
                "env": {
                    "PATH": "$HOME/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
                }
            },
            "variants": [
                {
                    "name": "Build & Run Debug x86 / x64",
                    "windows": {
                        "shell_cmd": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-windows.ps1 -Architecture x86 -Run"
                    },
                    "osx": {
                        "shell_cmd": "cargo run --bin see_my_mac --locked --target x86_64-apple-darwin",
                        "env": {
                            "PATH": "$HOME/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
                        }
                    },
                    "linux": {
                        "shell_cmd": "cargo run --bin see_my_mac --locked --target x86_64-unknown-linux-gnu",
                        "env": {
                            "PATH": "$HOME/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
                        }
                    }
                }
            ]
        },
